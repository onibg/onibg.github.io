name: 測試 cron-job 4的倍數整點觸發
on:
 workflow_dispatch: #手動觸發
jobs:
 test:
  runs-on: ubuntu-latest
  steps:
   - name: 持續執行
     run: |
      node<<'EOF'
      console.log('開始:',new Date().toLocaleString('zh-TW',{timeZone:'Asia/Taipei'}))
      let ws;connect()
      function connect(){
       ws=new WebSocket('wss://w-i-w.onrender.com')
       ws.onopen=()=>console.log('WebSocket已連線')
       ws.onmessage=event=>console.log('Render Server回覆:',event.data)
       ws.onerror=err=>console.error('WebSocket錯誤:',err)
       ws.onclose=event=>{
        console.log('WebSocket關閉:',event)
        setTimeout(connect,1000)
       }
      }
      setInterval(()=>{
       if(ws?.readyState===WebSocket.OPEN){
        console.log(new Date().toLocaleString('zh-TW',{timeZone:'Asia/Taipei'}),'ws.send()')
        ws.send('我是Github Actions')
       }else console.log('WebSocket尚未連線，略過此次ws.send()')
      },60000)
      EOF
